DATABASE_URL=sqlite:///planner.db
FRONTEND_ORIGIN=http://localhost:5173
DEMO_MODE=false

# Managed Canvas browser (manual Rutgers login; no Canvas API token)
CANVAS_BASE_URL=https://rutgers.instructure.com
CANVAS_ALLOWED_ORIGINS=https://rutgers.instructure.com,https://netid.rutgers.edu
CANVAS_BROWSER_CHANNEL=chrome
CANVAS_SCAN_INTERVAL_HOURS=8
CANVAS_WORKER_MODEL=glm-5.3-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Local MCP. Generate a strong token before enabling write tools.
MCP_WRITE_TOKEN=
MCP_REMOTE_ENABLED=false

# Provider API keys are entered in the desktop app and encrypted with the OS facility.
# Never place real API keys in this file.

# Copy this file to .env and fill it in (`python scripts/jig.py setup` copies it for you).
# .env is git-ignored. Never commit real keys.

# Meta Model API key from https://dev.meta.ai/ (looks like LLM|<numeric id>|<secret>).
# Powers the planner, modeler, fixer, sketch vision, SAM, voice and image features.
MODEL_API_KEY=

# Optional. Baseten key for the Muse Spark Open verifier agent.
# Without it, the verifier falls back to the Meta Model API.
BASETEN_API_KEY=

# Stop calling models once this session's estimated spend reaches this many USD.
JIG_BUDGET_USD=20

# Optional. Full path to the CalculiX solver if `ccx` is not on PATH,
# e.g. C:\Tools\calculix\ccx.exe or /opt/homebrew/bin/ccx
JIG_CCX=

# Optional. Where builds are stored. Defaults to a .jig folder in your home directory.
JIG_DATA_DIR=
